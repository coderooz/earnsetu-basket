# Git attributes — normalize line endings and mark generated/binary files.
# https://git-scm.com/docs/gitattributes

# Default: normalize to LF in the repository for all text files.
* text=auto eol=lf

# Explicit text types
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows scripts should keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Lockfiles: keep as-is, treat as generated
package-lock.json text eol=lf linguist-generated=true -diff

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Linguist: don't count generated output
.expo/ linguist-generated=true
dist/ linguist-generated=true
web-build/ linguist-generated=true
nativewind-env.d.ts linguist-generated=true
