# EditorConfig — https://editorconfig.org
# Ensures consistent editor behaviour across editors and IDEs.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf

# Kotlin / Gradle — relevant only if native code is generated via `expo prebuild`
[*.{kt,kts}]
indent_size = 4

[*.gradle]
indent_size = 4

[*.{png,jpg,jpeg,gif,ico,webp}]
insert_final_newline = false
